<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The scanner needs the camera. The plugin requests the runtime permission itself
         (requestPermission on the particle_code/scanner channel). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Devices without a camera can still install the app and show codes. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
</manifest>
